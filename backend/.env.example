# Copy this file to backend/.env and fill values
AZURE_OPENAI_ENDPOINT=https://<your-azure-openai>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-aoai-key>
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

AZURE_SPEECH_KEY=<your-speech-key>
AZURE_SPEECH_REGION=australiaeast

# Frontend dev domain(s), comma-separated
CORS_ORIGINS=http://localhost:5173

# CosyVoice2 TTS microservice (required for speech synthesis)
# In Docker Compose this is automatically set to http://cosyvoice:9880
# For local dev without Docker point to wherever the service is running
COSYVOICE_URL=http://localhost:9880
COSYVOICE_ENABLED=true
# Azure TTS voice used as fallback when CosyVoice is unavailable
AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural
